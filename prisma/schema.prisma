generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===== AUTH (NextAuth) =====

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  nativeLanguage String   @default("fr")
  immersionMode  Boolean  @default(false)
  immersionLang  String?
  reputation     Int      @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  userLanguages  UserLanguage[]
  userProgress   UserProgress[]
  flashcards     Flashcard[]
  conversations  Conversation[]
  subscription   Subscription?
  apiUsageLogs   ApiUsageLog[]
  pronunciations PronunciationAttempt[]
  communityContent CommunityContent[]
  contentVotes   ContentVote[]
  clubMemberships ClubMember[]
  certifications Certification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===== LANGUES & COURS =====

model Language {
  id        String   @id @default(cuid())
  code      String   @unique // "en", "es", "de", "ja", "ar", "zh"
  name      String           // "Anglais", "Espagnol"
  flag      String           // emoji flag "🇬🇧"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  courses       Course[]
  userLanguages UserLanguage[]
}

model UserLanguage {
  id         String   @id @default(cuid())
  userId     String
  languageId String
  level      CECRLevel @default(A1)
  isActive   Boolean   @default(true)
  startedAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id])

  @@unique([userId, languageId])
}

enum CECRLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

model Course {
  id          String    @id @default(cuid())
  languageId  String
  level       CECRLevel
  title       String    // "Anglais - Débutant (A1)"
  description String?
  order       Int       @default(0)
  isPremium   Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  language Language @relation(fields: [languageId], references: [id])
  chapters Chapter[]
}

model Chapter {
  id          String   @id @default(cuid())
  courseId    String
  title       String   // "Au restaurant", "En voyage"
  description String?
  icon        String?  // emoji or icon name
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
}

model Lesson {
  id          String     @id @default(cuid())
  chapterId   String
  title       String     // "Commander un plat"
  description String?
  content     Json?      // structured lesson content (vocabulary, dialogues, grammar notes)
  order       Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  chapter      Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  exercises    Exercise[]
  userProgress UserProgress[]
}

// ===== EXERCICES =====

model Exercise {
  id         String       @id @default(cuid())
  lessonId   String
  type       ExerciseType
  question   Json         // { text, audio_url, image_url, options, correct_answer, hints }
  order      Int          @default(0)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())

  lesson         Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userProgress   UserProgress[]
  pronunciations PronunciationAttempt[]
}

enum ExerciseType {
  MULTIPLE_CHOICE    // QCM contextuel
  FILL_IN_BLANK      // Compléter la phrase
  TRANSLATION        // Traduction (dans les deux sens)
  LISTENING          // Compréhension orale
  WRITING            // Production écrite (évaluée par IA)
  REORDER            // Remettre les mots dans l'ordre
  MATCHING           // Associer les paires
  CONTEXT_GUESS      // Deviner le sens d'un mot par le contexte (profil immersif)
  SPOT_ERROR         // Trouver et corriger l'erreur dans une phrase (profil analytique)
  DIALOGUE_COMPLETE  // Compléter un dialogue réaliste (profil communicatif)
  FREE_PRODUCTION    // Production libre évaluée par IA (profil actif)
  PRONUNCIATION      // Exercice de prononciation (reconnaissance vocale)
}

// ===== PROGRESSION =====

model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String?
  exerciseId  String?
  score       Int?     // 0-100
  completed   Boolean  @default(false)
  attempts    Int      @default(0)
  timeSpent   Int      @default(0) // in seconds
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson   Lesson?   @relation(fields: [lessonId], references: [id])
  exercise Exercise? @relation(fields: [exerciseId], references: [id])

  @@unique([userId, lessonId])
  @@unique([userId, exerciseId])
}

// ===== FLASHCARDS SRS =====

model Flashcard {
  id            String         @id @default(cuid())
  userId        String
  front         String         // word/phrase in target language
  back          String         // translation + context
  audioUrl      String?
  languageCode  String         // "en", "es"
  source        FlashcardSource @default(LESSON)

  // SRS fields (SM-2+ algorithm)
  easeFactor    Float          @default(2.5)
  interval      Int            @default(0)   // days
  repetitions   Int            @default(0)
  nextReview    DateTime       @default(now())
  lastReview    DateTime?
  mastery       MasteryLevel   @default(NEW)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nextReview])
  @@index([userId, languageCode])
}

enum FlashcardSource {
  LESSON
  MANUAL
  CONVERSATION
  COMMUNITY
}

enum MasteryLevel {
  NEW
  LEARNING
  ACQUIRED
  MASTERED
}

// ===== CONVERSATIONS IA =====

model Conversation {
  id           String   @id @default(cuid())
  userId       String
  scenarioId   String   // references a predefined scenario
  languageCode String
  messages     Json     // array of { role, content, timestamp }
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, languageCode])
}

// ===== ABONNEMENT =====

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(FREE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

// ===== PROMO CODES =====

model PromoCode {
  id          String   @id @default(cuid())
  code        String   @unique // normalized lowercase
  label       String   // "Fondateur", "Early Bird", etc.
  maxUses     Int?     // null = unlimited
  currentUses Int      @default(0)
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  redemptions PromoRedemption[]
}

model PromoRedemption {
  id          String   @id @default(cuid())
  promoCodeId String
  userId      String
  redeemedAt  DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id])

  @@unique([promoCodeId, userId]) // each user can redeem a code only once
}

// ===== STRIPE WEBHOOK IDEMPOTENCY =====

model ProcessedWebhookEvent {
  id          String   @id // Stripe event ID (evt_xxx)
  type        String   // event type
  processedAt DateTime @default(now())

  @@index([processedAt])
}

// ===== API USAGE TRACKING =====

model ApiUsageLog {
  id             String   @id @default(cuid())
  userId         String
  endpoint       String   // "/api/chat", "/api/exercises/evaluate"
  modelUsed      String   // "claude-haiku-4-5", "claude-sonnet-4-6"
  inputTokens    Int
  outputTokens   Int
  costEstimated  Float    // in USD
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ===== RECONNAISSANCE VOCALE =====

model PronunciationAttempt {
  id             String   @id @default(cuid())
  userId         String
  exerciseId     String?
  targetText     String
  spokenText     String
  languageCode   String
  accuracyScore  Float    // 0.0 - 1.0
  aiFeedback     String?  // AI-generated pronunciation tips
  createdAt      DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exerciseId], references: [id])

  @@index([userId, languageCode])
}

// ===== CONTENU COMMUNAUTAIRE =====

model CommunityContent {
  id             String               @id @default(cuid())
  authorId       String
  languageCode   String
  type           CommunityContentType
  title          String
  description    String?
  content        Json
  level          CECRLevel
  status         ModerationStatus     @default(PENDING)
  reviewedBy     String?
  reviewNote     String?
  upvotes        Int                  @default(0)
  downvotes      Int                  @default(0)
  usageCount     Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes  ContentVote[]

  @@index([languageCode, status])
  @@index([authorId])
}

model ContentVote {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  vote      Int      // +1 or -1
  createdAt DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  content CommunityContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
}

enum CommunityContentType {
  LESSON
  DIALOGUE
  FLASHCARD_PACK
  EXERCISE_SET
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

// ===== CLUBS / GROUPES =====

model Club {
  id           String   @id @default(cuid())
  name         String
  description  String?
  languageCode String
  ownerId      String
  avatarUrl    String?
  isPublic     Boolean  @default(true)
  maxMembers   Int      @default(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members    ClubMember[]
  challenges ClubChallenge[]

  @@index([languageCode])
}

model ClubMember {
  id       String   @id @default(cuid())
  clubId   String
  userId   String
  role     ClubRole @default(MEMBER)
  joinedAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
}

model ClubChallenge {
  id          String        @id @default(cuid())
  clubId      String
  title       String
  description String?
  type        ChallengeType
  target      Int
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime      @default(now())

  club         Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  participants ChallengeProgress[]
}

model ChallengeProgress {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  progress    Int      @default(0)
  updatedAt   DateTime @updatedAt

  challenge ClubChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
}

enum ClubRole {
  OWNER
  ADMIN
  MEMBER
}

enum ChallengeType {
  FLASHCARDS_REVIEWED
  LESSONS_COMPLETED
  CONVERSATIONS_HELD
  EXERCISES_DONE
  PRACTICE_MINUTES
}

// ===== CERTIFICATIONS =====

model CertificationExam {
  id           String    @id @default(cuid())
  languageCode String
  level        CECRLevel
  title        String
  description  String?
  durationMin  Int
  passScore    Int       // 0-100
  questions    Json
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  attempts Certification[]

  @@unique([languageCode, level])
}

model Certification {
  id             String    @id @default(cuid())
  userId         String
  examId         String
  score          Int       // 0-100
  passed         Boolean
  answers        Json
  timeSpent      Int       // seconds
  certificateUrl String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  user User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam CertificationExam @relation(fields: [examId], references: [id])

  @@index([userId])
}
